---
import { joinCommunityUrl } from "@/lib/navigation";
---

<section class="site-section bg-background">
	<div class="site-container">
		<div>
			<div class="max-w-3xl">
				<p class="eyebrow">Ways to participate</p>
				<h2 class="mt-4">
					Pick the level of involvement that fits you.
				</h2>
				<p class="lead mt-6">
					You do not need a polished talk or an official role to take part.
					Start by showing up, then contribute more when you have something
					useful to share or space to help.
				</p>
			</div>

			<div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
				<div class="aws-card aws-card-hover flex min-h-72 flex-col bg-background p-6">
					<p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">
						Show up
					</p>
					<h3 class="mt-6">Attend a meetup</h3>
					<p class="mt-3 text-sm">
						Join a session, meet local AWS builders, and bring questions from
						your own learning or work.
					</p>
					<div class="mt-auto pt-8">
						<p class="border-t border-border pt-4 text-sm font-bold text-foreground">
							Best first step
						</p>
					</div>
				</div>

				<div class="aws-card aws-card-hover flex min-h-72 flex-col bg-background p-6">
					<p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">
						Share
					</p>
					<h3 class="mt-6">Give a short session</h3>
					<p class="mt-3 text-sm">
						Turn a demo, architecture decision, migration note, bug fix, or
						lesson learned into something other builders can use.
					</p>
					<div class="mt-auto pt-8">
						<p class="border-t border-border pt-4 text-sm font-bold text-foreground">
							Great for builders
						</p>
					</div>
				</div>

				<div class="aws-card aws-card-hover flex min-h-72 flex-col bg-background p-6">
					<p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">
						Host
					</p>
					<h3 class="mt-6">Offer a place to gather</h3>
					<p class="mt-3 text-sm">
						Help with a classroom, office, lab, community room, or workshop
						space where builders can meet.
					</p>
					<div class="mt-auto pt-8">
						<p class="border-t border-border pt-4 text-sm font-bold text-foreground">
							Useful for teams
						</p>
					</div>
				</div>

				<div class="aws-card aws-card-hover flex min-h-72 flex-col bg-background p-6">
					<p class="text-sm font-bold uppercase tracking-[0.16em] text-primary">
						Support
					</p>
					<h3 class="mt-6">Help run the community</h3>
					<p class="mt-3 text-sm">
						Support planning, speaker coordination, event operations,
						documentation, or community communication.
					</p>
					<div class="mt-auto pt-8">
						<p class="border-t border-border pt-4 text-sm font-bold text-foreground">
							For regulars
						</p>
					</div>
				</div>
			</div>

			<div class="mt-6 border border-border bg-muted p-6 sm:flex sm:items-center sm:justify-between sm:gap-6">
				<div>
					<h3 class="text-xl">Not sure where to start?</h3>
					<p class="mt-2 text-sm">
						Join the Meetup group first. You can attend quietly, ask a
						question, or reach out when you are ready to contribute.
					</p>
				</div>
				<a
					href={joinCommunityUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="button-primary mt-5 shrink-0 sm:mt-0"
				>
					Join the Meetup
				</a>
			</div>
		</div>
	</div>
</section>

---
import { faqs } from "./faqs";
---

<section class="site-section bg-background">
	<div class="site-container">
		<div class="max-w-3xl">
			<p class="eyebrow">FAQ</p>
			<h2 class="mt-4">
				Common questions about the community.
			</h2>
		</div>

		<dl class="mt-10 grid gap-x-8 gap-y-8 md:grid-cols-2">
			{
				faqs.map((faq) => (
					<div class="border-t border-border pt-5">
						<dt class="text-lg font-bold text-foreground">{faq.question}</dt>
						<dd class="mt-3 text-sm">{faq.answer}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

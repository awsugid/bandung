---
import { events } from "@/lib/events";
---

<section class="border-b border-border bg-background py-10 sm:py-12">
	<div class="site-container">
		<div class="border border-border bg-muted">
			<div class="border-b border-border p-6 sm:p-7">
				<p class="eyebrow">Community momentum</p>
				<h2 class="mt-3 max-w-3xl text-2xl leading-tight sm:text-3xl">
					A growing Bandung cloud community, built meetup by meetup.
				</h2>
			</div>

			<div class="grid divide-y divide-border md:grid-cols-3 md:divide-x md:divide-y-0">
				<div class="bg-background p-6 sm:p-7">
					<p class="text-5xl font-bold leading-none text-foreground sm:text-6xl">
						200+
					</p>
					<h3 class="mt-5 text-lg">members and counting</h3>
					<p class="mt-2 text-sm">
						Builders, students, operators, and cloud-curious people following
						the Bandung group.
					</p>
				</div>

				<div class="bg-background p-6 sm:p-7">
					<p class="text-5xl font-bold leading-none text-foreground sm:text-6xl">
						{events.length}
					</p>
					<h3 class="mt-5 text-lg">events so far</h3>
					<p class="mt-2 text-sm">
						More sessions are on the way as topics, speakers, and venues are
						confirmed.
					</p>
				</div>

				<div class="bg-background p-6 sm:p-7">
					<p class="text-5xl font-bold leading-none text-foreground sm:text-6xl">
						5.0
					</p>
					<h3 class="mt-5 text-lg">average rating</h3>
					<p class="mt-2 text-sm">
						Based on community ratings from people who joined previous
						sessions.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

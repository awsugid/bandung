---
import EventCard from "@/components/EventCard.astro";
import NextEventCard from "@/components/NextEventCard.astro";
import { featuredEvent, hasUpcomingEvent, pastEvents } from "@/lib/events";
import { joinCommunityUrl } from "@/lib/navigation";

// Set when an upcoming event is featured; the layout's date script swaps
// this section to its ended state after the event ends.
const endsAt = hasUpcomingEvent ? featuredEvent.endDate : undefined;
---

<section class="site-section bg-muted">
	<div class="site-container">
		<div class="max-w-3xl">
			<p class="eyebrow">Events</p>
			<h2 class="mt-4" data-until={endsAt}>
				{hasUpcomingEvent ? "Join the next meetup." : "The next meetup is on its way."}
			</h2>
			{endsAt && <h2 class="mt-4" hidden data-after={endsAt}>The next meetup is on its way.</h2>}
		</div>

		<div class="mt-10">
			{
				hasUpcomingEvent && (
					<div data-until={endsAt}>
						<NextEventCard event={featuredEvent} detailsHref="/events" />
					</div>
				)
			}
			<div class="rounded-lg bg-primary p-6 text-aws-ink sm:p-10" hidden={hasUpcomingEvent} data-after={endsAt}>
				<div class="sm:flex sm:items-center sm:justify-between sm:gap-8">
					<div class="max-w-2xl">
						<h3 class="text-3xl leading-tight text-aws-ink">
							The next session is being planned.
						</h3>
						<p class="mt-3 text-base leading-7 text-aws-ink/80">
							Follow the Meetup group to be notified as soon as registration opens.
						</p>
					</div>
					<a
						href={joinCommunityUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="mt-6 inline-flex h-12 shrink-0 items-center justify-center rounded-md bg-aws-ink px-6 text-sm font-bold text-white transition hover:bg-aws-ink-soft sm:mt-0"
					>
						Follow on Meetup
					</a>
				</div>
			</div>
		</div>

		<div class="mt-16 flex items-end justify-between gap-6">
			<h3 class="text-2xl">Recent meetups</h3>
			<a href="/events" class="text-sm font-bold text-foreground">
				All past events
				<span class="ml-2" aria-hidden="true">-&gt;</span>
			</a>
		</div>

		<div class="mt-6 grid gap-5 md:grid-cols-3" data-limit="3">
			{
				[...(endsAt ? [featuredEvent] : []), ...pastEvents.slice(0, 3)].map((event) => (
					<div hidden={event.phase === "next"} data-after={event.phase === "next" ? event.endDate : undefined}>
						<EventCard
							title={event.title}
							description={event.description}
							dateLabel={event.dateLabel}
							href={event.meetupUrl}
							ctaLabel="View on Meetup"
							imageUrl={event.imageUrl}
						/>
					</div>
				))
			}
		</div>
	</div>
</section>

---
import { joinCommunityUrl } from "@/lib/navigation";
---

<section class="relative overflow-hidden bg-background">
	<div class="absolute inset-x-0 top-0 h-28 bg-[linear-gradient(180deg,var(--aws-frost),transparent)]"></div>
	<div class="site-container relative pb-16 pt-14 lg:pb-24 lg:pt-20">
		<div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-end lg:gap-14">
			<div>
				<p class="eyebrow">AWS User Group Bandung</p>
				<h1 class="mt-5 max-w-4xl">
					Learn AWS Cloud with builders in Bandung.
				</h1>
			</div>

			<div>
				<p class="lead">
					Join community-led meetups for technical talks, hands-on learning,
					and practical conversations with local developers, architects,
					students, and cloud practitioners.
				</p>

				<div class="mt-7 flex flex-col gap-3 sm:flex-row">
					<a
						href={joinCommunityUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="button-primary"
					>
						Join the Meetup
					</a>
					<a href="/events" class="button-secondary">
						View events
					</a>
				</div>
			</div>
		</div>

		<figure class="hero-photo relative mt-12 lg:mt-16">
			<div
				class="absolute -bottom-3 -right-3 h-3/4 w-3/4 rounded-[1.75rem] bg-primary sm:-bottom-5 sm:-right-5"
				aria-hidden="true"
			></div>
			<div class="relative aspect-[4/3] overflow-hidden rounded-[1.5rem] bg-aws-ink shadow-[0_24px_48px_hsl(213_28%_11%_/_0.18),0_64px_120px_hsl(213_28%_11%_/_0.16)] sm:aspect-[16/9] lg:aspect-[2/1]">
				<img
					src="/images/community-hero.webp"
					srcset="/images/community-hero-1200.webp 1200w, /images/community-hero.webp 2400w"
					sizes="(min-width: 70rem) 70rem, 100vw"
					width="2400"
					height="1200"
					alt="AWS User Group Bandung members at a community meetup at BLOCK71 Bandung"
					fetchpriority="high"
					class="hero-photo-img absolute inset-0 h-full w-full object-cover object-center"
				/>
				<div class="absolute inset-x-0 bottom-0 h-1/2 bg-[linear-gradient(180deg,transparent,hsl(213_28%_11%_/_0.7))]"></div>
				<figcaption class="absolute bottom-0 left-0 p-5 text-sm font-semibold text-white sm:p-7 sm:text-base">
					October Monthly Meetup 2026 - Dicoding DevCoach x AWS UG Bandung
				</figcaption>
			</div>
		</figure>
	</div>
</section>

<style>
	@media (prefers-reduced-motion: no-preference) {
		.hero-photo {
			animation: hero-photo-reveal 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
		}

		.hero-photo-img {
			animation: hero-photo-settle 1600ms cubic-bezier(0.22, 1, 0.36, 1) both;
		}
	}

	@keyframes hero-photo-reveal {
		from {
			opacity: 0;
			transform: translateY(2rem);
		}
	}

	@keyframes hero-photo-settle {
		from {
			transform: scale(1.08);
		}
	}
</style>

---
import { joinCommunityUrl } from "@/lib/navigation";
---

<section class="relative overflow-hidden bg-background">
	<div class="absolute inset-x-0 top-0 h-28 bg-[linear-gradient(180deg,var(--aws-frost),transparent)]"></div>
	<div class="site-container relative grid min-h-[calc(100vh-var(--header-height))] items-center gap-12 py-16 lg:grid-cols-[1.08fr_0.92fr] lg:py-20">
		<div class="max-w-3xl">
			<p class="eyebrow">AWS User Group Bandung</p>
			<h1 class="mt-5 max-w-4xl">
				Learn AWS Cloud with builders in Bandung.
			</h1>
			<p class="lead mt-6 max-w-2xl">
				Join community-led meetups for technical talks, hands-on learning,
				and practical conversations with local developers, architects,
				students, and cloud practitioners.
			</p>

			<div class="mt-9 flex flex-col gap-3 sm:flex-row">
				<a
					href={joinCommunityUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="button-primary"
				>
					Join the Meetup
				</a>
				<a href="/events" class="button-secondary">
					View events
				</a>
			</div>
		</div>

		<figure class="relative lg:translate-x-3 lg:translate-y-5">
			<div class="absolute -inset-x-3 -inset-y-2 rotate-[-3deg] rounded-[1.7rem] border border-border bg-muted shadow-[0_10px_28px_hsl(213_28%_11%_/_0.08)] sm:-inset-x-5 sm:-inset-y-4"></div>
			<div class="absolute -inset-x-2 -inset-y-1 rotate-[2deg] rounded-[1.6rem] border border-border bg-background shadow-[0_16px_36px_hsl(213_28%_11%_/_0.08)] sm:-inset-x-4 sm:-inset-y-3"></div>
			<div class="relative rounded-[1.35rem] border border-border bg-background p-3 shadow-[0_18px_36px_hsl(213_28%_11%_/_0.12),0_48px_90px_hsl(213_28%_11%_/_0.12)] sm:rotate-[0.6deg] sm:p-4 lg:rotate-[1.1deg]">
				<div class="relative aspect-[5634/3583] overflow-hidden rounded-[1rem] bg-aws-ink">
					<img
						src="/images/community-hero.webp"
						alt="AWS User Group Bandung members at a community meetup"
						class="absolute inset-0 h-full w-full object-cover object-center"
					/>
					<div class="absolute inset-0 bg-[linear-gradient(180deg,hsl(213_28%_11%_/_0.01),hsl(213_28%_11%_/_0.36))]"></div>
				</div>
			</div>
		</figure>
	</div>
</section>

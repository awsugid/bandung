---
const topics = ["Architecture", "DevOps", "Data", "AI/ML", "Security"];
---

<section class="site-section">
	<div class="site-container grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
		<div class="lg:sticky lg:top-28 lg:self-start">
			<p class="eyebrow">What you'll learn</p>
			<h2 class="mt-4 uppercase">Practitioners, not vendors.</h2>
			<p class="lead mt-6">
				Every talk comes from someone in the AWS community who runs this stuff
				in real systems.
			</p>
			<p class="mt-6 text-sm">
				For developers, DevOps and platform engineers, cloud architects,
				startup founders, and IT professionals from Bandung and beyond.
			</p>
		</div>

		<ol class="border-t border-border">
			{topics.map((topic, index) => (
				<li class="topic group flex items-baseline gap-6 border-b border-border py-6 sm:py-8">
					<span class="w-8 shrink-0 text-sm font-bold text-muted-foreground">0{index + 1}</span>
					<span class="topic-name comday-flow text-4xl font-bold uppercase leading-none text-white sm:text-6xl">
						{topic}
					</span>
				</li>
			))}
		</ol>
	</div>
</section>

<style>
	.topic-name {
		-webkit-background-clip: text;
		background-clip: text;
		transition: color 0.4s ease;
	}

	.topic:hover .topic-name {
		color: transparent;
	}
</style>

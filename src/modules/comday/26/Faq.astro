---
import { instagramUrl } from "@/lib/navigation";

const groups = [
	{
		title: "Registration",
		faqs: [
			{
				question: "Who can attend?",
				answer:
					"Anyone building on AWS or curious about it: developers, architects, founders, IT professionals, and students. You don't need AWS experience to join.",
			},
			{
				question: "Why does my registration need approval?",
				answer:
					"Seats are limited, so our team reviews every registration to keep the day full of people who plan to come. You'll get an email as soon as yours is reviewed.",
			},
			{
				question: "Can I register for a friend?",
				answer:
					"Each order holds one ticket, and the name on it is printed on the badge. Ask your friends to register themselves.",
			},
			{
				question: "What if registration is full?",
				answer:
					"Join the waiting list from the ticket section. When a seat frees up, people on the waiting list are offered it first.",
			},
		],
	},
	{
		title: "Payment and refunds",
		faqs: [
			{
				question: "Is Community Day free?",
				answer:
					"The ticket carries a small commitment fee, shown on the ticket above. It holds your seat, and you get it back when you check in on the day.",
			},
			{
				question: "Why is there a commitment fee?",
				answer:
					"Free tickets tend to go to people who don't show up. A small fee you get back keeps seats for people who will be there.",
			},
			{
				question: "How do I pay?",
				answer:
					"After approval, open the payment link in your email. The payment page shows a QR code from AWS User Group Indonesia. Scan it with your e-wallet or mobile banking app.",
			},
			{
				question: "Why does the payment say AWS User Group Indonesia?",
				answer:
					"Payments go through the AWS User Group Indonesia ticketing system, which runs registration for community events across the country.",
			},
			{
				question: "How long do I have to pay?",
				answer:
					"Until the end of the second day after your approval. Unpaid orders expire after that and the seat goes to someone else.",
			},
			{
				question: "When do I get my money back?",
				answer:
					"Check in on the day and we refund your commitment fee at the end of the day. If you don't show up, the fee isn't refunded.",
			},
			{
				question: "Will I get an invoice?",
				answer: "Yes. Your ticket and invoice arrive by email once your payment goes through.",
			},
		],
	},
	{
		title: "On the day",
		faqs: [
			{
				question: "What do I need to bring?",
				answer:
					"Your ticket. Show its QR code at registration, on your phone or printed. We'll share anything else, like what to bring to a workshop, before the day.",
			},
			{
				question: "I can't make it anymore. What should I do?",
				answer:
					"Let us know as early as you can so we can pass your seat to someone on the waiting list.",
			},
			{
				question: "I didn't get an email from you.",
				answer:
					"Check your spam folder first. You can also request your order link again from the ticket shop, or reach out to us.",
			},
		],
	},
];
---

<section class="site-section border-t border-border">
	<div class="site-container grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
		<div class="lg:sticky lg:top-28 lg:self-start">
			<p class="eyebrow">FAQ</p>
			<h2 class="mt-4 uppercase">Good questions.</h2>
			<p class="lead mt-6">
				Registration, the commitment fee, and what to expect on the day.
			</p>

			<div class="mt-10 rounded-xl border border-border bg-card p-6">
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-muted-foreground">Still stuck?</p>
				<p class="mt-3 text-white">We're happy to help.</p>
				<div class="mt-5 flex flex-col gap-3 text-sm">
					<a
						href={instagramUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="group flex items-center justify-between gap-4 rounded-md border border-white/30 px-4 py-3 font-bold text-white transition hover:border-primary hover:text-primary"
					>
						DM @awsugbandung
						<span class="transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">↗</span>
						<span class="sr-only">(opens in a new tab)</span>
					</a>
					<a
						href="mailto:awsugbandung@gmail.com"
						class="flex items-center justify-between gap-4 rounded-md border border-white/30 px-4 py-3 font-bold text-white transition hover:border-primary hover:text-primary"
					>
						awsugbandung@gmail.com
						<span aria-hidden="true">→</span>
					</a>
				</div>
			</div>
		</div>

		<div class="grid gap-12">
			{groups.map((group) => (
				<div>
					<h3 class="text-xs font-bold uppercase tracking-[0.18em] text-primary">{group.title}</h3>
					<div class="mt-4 border-t border-border">
						{group.faqs.map((faq) => (
							<details name="comday-faq" class="faq group border-b border-border">
								<summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-bold text-white outline-none transition hover:text-primary focus-visible:text-primary [&::-webkit-details-marker]:hidden">
									{faq.question}
									<span
										class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-border transition group-open:border-primary group-open:text-primary"
										aria-hidden="true"
									>
										<svg
											viewBox="0 0 24 24"
											class="h-4 w-4 transition-transform duration-300 group-open:rotate-45"
											fill="none"
											stroke="currentColor"
											stroke-width="2.25"
											stroke-linecap="round"
										>
											<path d="M12 5v14M5 12h14"></path>
										</svg>
									</span>
								</summary>
								<p class="max-w-2xl pb-6 pr-14">{faq.answer}</p>
							</details>
						))}
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	/* Animate answers open and closed where the browser supports it. */
	.faq {
		interpolate-size: allow-keywords;
	}

	.faq::details-content {
		block-size: 0;
		overflow: hidden;
		transition:
			block-size 0.3s ease,
			content-visibility 0.3s allow-discrete;
	}

	.faq[open]::details-content {
		block-size: auto;
	}

	@media (prefers-reduced-motion: reduce) {
		.faq::details-content {
			transition: none;
		}
	}
</style>

---
import { event } from "./event";
---

<section class="relative bg-muted py-16 sm:py-24">
	<div class="site-container">
		<div class="overflow-hidden rounded-2xl border border-border bg-card">
			<div class="h-1 bg-[image:var(--comday-gradient)]"></div>

			<dl class="grid divide-y divide-border sm:grid-cols-3 sm:divide-x sm:divide-y-0">
				<div class="p-6 sm:p-8">
					<dt class="label">Date</dt>
					<dd class="mt-4">
						<span class="block text-5xl font-bold leading-none text-white sm:text-6xl lg:text-7xl">07</span>
						<span class="mt-2 block text-lg font-bold uppercase tracking-[0.2em] text-primary">Nov 2026</span>
						<span class="mt-1 block text-sm text-muted-foreground">Saturday</span>
					</dd>
				</div>
				<div class="p-6 sm:p-8">
					<dt class="label">Time</dt>
					<dd class="mt-4">
						<span class="block text-5xl font-bold leading-none text-white sm:text-6xl lg:text-7xl">09<span class="text-primary">.</span>00</span>
						<span class="mt-2 block text-lg font-bold uppercase tracking-[0.2em] text-primary">to 16.00</span>
						<span class="mt-1 block text-sm text-muted-foreground">Western Indonesia Time</span>
					</dd>
				</div>
				<div class="p-6 sm:p-8">
					<dt class="label">Venue</dt>
					<dd class="mt-4">
						<span class="block text-5xl font-bold leading-none text-white sm:text-6xl lg:text-7xl">SBM</span>
						<span class="mt-2 block text-lg font-bold uppercase tracking-[0.2em] text-primary">ITB</span>
						<a
							href={event.mapUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="mt-1 block text-sm text-muted-foreground underline decoration-border underline-offset-4 hover:text-white hover:decoration-primary"
						>
							{event.venue}, {event.address}
						</a>
					</dd>
				</div>
			</dl>
		</div>
	</div>
</section>

<style>
	.label {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
</style>

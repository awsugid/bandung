---
import { instagramUrl } from "@/lib/navigation";
import ComingSoonButton from "./ComingSoonButton.astro";

const channels = [
	{ name: "Telegram", href: "https://t.me/awsugbandung" },
	{ name: "Instagram", href: instagramUrl },
	{ name: "bandung.awscommunity.id", href: "https://bandung.awscommunity.id" },
];
---

<section class="relative isolate overflow-hidden py-24 sm:py-32">
	<img
		src="/images/comday/2026/hex-bottom-left.webp"
		alt=""
		class="pointer-events-none absolute -bottom-8 -left-8 -z-10 w-40 opacity-50 sm:w-60"
	/>
	<img
		src="/images/comday/2026/hex-top-right.webp"
		alt=""
		class="pointer-events-none absolute -right-8 -top-8 -z-10 w-40 opacity-50 sm:w-60"
	/>
	<div class="site-container text-center">
		<h2 class="mx-auto max-w-3xl text-4xl uppercase sm:text-6xl">
			Save the date. <span class="text-primary">Registration opens soon.</span>
		</h2>
		<p class="lead mx-auto mt-6 max-w-xl">
			Follow AWS User Group Bandung to hear the moment seats and speakers are
			announced.
		</p>

		<div class="mt-10 flex justify-center">
			<ComingSoonButton label="Register" />
		</div>

		<ul class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
			{channels.map((channel) => (
				<li>
					<a
						href={channel.href}
						target="_blank"
						rel="noopener noreferrer"
						class="font-bold text-white underline decoration-white/30 underline-offset-4 hover:decoration-primary"
					>
						{channel.name}
					</a>
				</li>
			))}
		</ul>
	</div>
</section>

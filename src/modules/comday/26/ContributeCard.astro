---
import { joinCommunityUrl } from "@/lib/navigation";

interface Props {
	index: string;
	role: string;
	title: string;
	body: string;
	cta: string;
	url: string;
	opensAt?: string;
	closesAt?: string;
	closedBody: string;
}

const { index, role, title, body, cta, url, opensAt, closesAt, closedBody } = Astro.props;

// Each state swaps in the browser through the layout's date script; a rebuild
// renders whichever state is current. Without dates the card stays upcoming.
const now = Date.now();
const opens = Date.parse(opensAt ?? "");
const closes = Date.parse(closesAt ?? "");
const hasWindow = Boolean(opensAt && closesAt);
const state = !hasWindow || now < opens ? "upcoming" : now < closes ? "open" : "closed";
const daysLeft = Math.max(Math.ceil((closes - now) / 86_400_000), 0);
const elapsed = Math.min(Math.max((now - opens) / (closes - opens), 0), 1);

const date = (iso: string) =>
	new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "Asia/Jakarta" }).format(
		Date.parse(iso),
	);
const time = hasWindow && new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "Asia/Jakarta" })
	.format(closes)
	.replace(":", ".");
---

<article class="group relative isolate h-full rounded-xl bg-border p-px">
	<div
		class="comday-flow absolute inset-0 -z-10 rounded-xl opacity-0 transition duration-500 group-hover:opacity-100"
		aria-hidden="true"
	>
	</div>
	<div class="relative flex h-full flex-col overflow-hidden rounded-[calc(0.75rem-1px)] bg-card p-6 sm:p-8">
		<span
			class="pointer-events-none absolute -right-2 -top-6 select-none text-[7rem] font-bold leading-none text-white/[0.04] transition duration-500 group-hover:text-white/[0.08]"
			aria-hidden="true">{index}</span
		>

		<p class="text-xs font-bold uppercase tracking-[0.18em] text-muted-foreground">{role}</p>
		<h3 class="mt-4 text-3xl uppercase sm:text-4xl">{title}</h3>
		<p class="mt-4 max-w-md text-muted-foreground">{body}</p>

		<div class="mt-auto pt-10">
			<div hidden={state !== "upcoming"} data-until={opensAt}>
				{opensAt && <p class="mb-4 text-sm font-bold text-white">Opens {date(opensAt)}</p>}
				<p
					class="flex h-12 cursor-not-allowed items-center justify-center gap-3 rounded-md border border-white/20 px-6 text-sm font-bold text-muted-foreground"
				>
					{cta}
					<span class="rounded-md bg-white/10 px-2.5 py-0.5 text-[0.65rem] uppercase tracking-[0.14em] text-comday-orange">
						Coming soon
					</span>
				</p>
			</div>

			{hasWindow && (
			<div hidden={state !== "open"} data-after={opensAt}>
				<div hidden={state === "closed"} data-until={closesAt} data-window={`${opensAt}|${closesAt}`}>
					<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-sm">
						<p class="flex items-center gap-2 whitespace-nowrap font-bold text-white">
							<span class="relative flex h-2 w-2" aria-hidden="true">
								<span class="pulse absolute inline-flex h-full w-full rounded-full bg-primary"></span>
								<span class="relative inline-flex h-2 w-2 rounded-full bg-primary"></span>
							</span>
							<span><span data-days>{daysLeft}</span> days left</span>
						</p>
						<p class="whitespace-nowrap text-muted-foreground">Closes {date(closesAt!)}, {time} WIB</p>
					</div>
					<div class="mt-3 h-1.5 overflow-hidden rounded-full bg-white/10">
						<div class="comday-flow h-full rounded-full" style={`width: ${(elapsed * 100).toFixed(1)}%`} data-progress>
						</div>
					</div>
					<a
						href={url}
						target="_blank"
						rel="noopener noreferrer"
						class="group/cta mt-6 flex h-12 items-center justify-center gap-3 rounded-md bg-primary px-6 text-sm font-bold text-primary-foreground transition hover:bg-[color-mix(in_oklab,var(--primary)_88%,white)]"
					>
						{cta}
						<span class="transition group-hover/cta:-translate-y-0.5 group-hover/cta:translate-x-0.5" aria-hidden="true"
							>↗</span
						>
						<span class="sr-only">(opens in a new tab)</span>
					</a>
				</div>
			</div>

			<div hidden={state !== "closed"} data-after={closesAt}>
				<p class="text-sm font-bold text-white">
					Closed on <span class="line-through decoration-primary decoration-2">{date(closesAt!)}</span>
				</p>
				<p class="mt-1 text-sm text-muted-foreground">{closedBody}</p>
				<a
					href={joinCommunityUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="mt-4 flex h-12 items-center justify-center gap-3 rounded-md border border-white/30 px-6 text-sm font-bold text-white transition hover:border-primary hover:text-primary"
				>
					Join the community
					<span aria-hidden="true">↗</span>
					<span class="sr-only">(opens in a new tab)</span>
				</a>
			</div>
			)}
		</div>
	</div>
</article>

<script>
	for (const el of document.querySelectorAll<HTMLElement>("[data-window]")) {
		const [opens, closes] = el.dataset.window!.split("|").map(Date.parse);
		const now = Date.now();
		const elapsed = Math.min(Math.max((now - opens) / (closes - opens), 0), 1);
		el.querySelector<HTMLElement>("[data-progress]")!.style.width = `${(elapsed * 100).toFixed(1)}%`;
		el.querySelector<HTMLElement>("[data-days]")!.textContent = String(Math.max(Math.ceil((closes - now) / 86_400_000), 0));
	}
</script>

<style>
	.pulse {
		animation: pulse 1.8s ease-out infinite;
	}

	@keyframes pulse {
		to {
			transform: scale(2.6);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pulse {
			animation: none;
		}
	}
</style>

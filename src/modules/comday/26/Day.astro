---
const workshopRooms = ["Classroom 1", "Classroom 2", "Classroom 3"];
---

<section class="site-section">
	<div class="site-container">
		<div class="max-w-2xl">
			<p class="eyebrow">The format</p>
			<h2 class="mt-4 uppercase">One main stage. Three workshop rooms.</h2>
			<p class="lead mt-5">
				Tech talks run in the main room through the day. After the noon break,
				three classrooms open for hands-on workshops.
			</p>
		</div>

		<div class="mt-12 grid gap-4 lg:grid-cols-[1.15fr_1fr]">
			<div class="rounded-xl bg-[image:var(--comday-gradient)] p-px">
				<div class="flex h-full flex-col rounded-[calc(0.75rem-1px)] bg-card p-6 sm:p-8">
					<p class="text-xs font-bold uppercase tracking-[0.18em] text-muted-foreground">Main room</p>
					<h3 class="mt-4 text-3xl uppercase sm:text-4xl">Tech talks</h3>
					<p class="mt-3">
						Talks with Q&A from community practitioners, from opening to the
						fireside chat that closes the day.
					</p>
					<p class="mt-auto pt-8 text-sm font-bold uppercase tracking-[0.18em] text-primary">
						Morning and afternoon
					</p>
				</div>
			</div>

			<ul class="grid gap-4">
				{workshopRooms.map((room) => (
					<li class="flex items-center justify-between gap-6 rounded-xl border border-border bg-card p-6">
						<div>
							<p class="text-xs font-bold uppercase tracking-[0.18em] text-muted-foreground">{room}</p>
							<h3 class="mt-2 uppercase">Workshop</h3>
						</div>
						<p class="text-right text-sm font-bold uppercase tracking-[0.18em] text-primary">After lunch</p>
					</li>
				))}
			</ul>
		</div>

		<div class="mt-4 flex flex-col gap-4 rounded-xl border border-dashed border-border p-6 sm:flex-row sm:items-center sm:justify-between">
			<p class="text-white">
				<span class="font-bold">Full schedule</span>
				<span class="text-muted-foreground">: session times, rooms, and workshop topics will be posted here.</span>
			</p>
			<span class="w-fit shrink-0 rounded-md bg-white/10 px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-comday-orange">
				Coming soon
			</span>
		</div>
	</div>
</section>

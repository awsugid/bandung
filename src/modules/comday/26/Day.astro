---
// Minutes per block, from the 09.00–16.00 tentative agenda.
const blocks = [
	{ label: "Registration and opening", time: "09.00", minutes: 50, kind: "session" },
	{ label: "3 tech talks", time: "09.50", minutes: 120, kind: "talk" },
	{ label: "Lunch and prayer", time: "11.50", minutes: 70, kind: "break" },
	{ label: "3 tech talks", time: "13.00", minutes: 120, kind: "talk" },
	{ label: "Fireside chat and closing", time: "15.00", minutes: 60, kind: "session" },
];
---

<section class="site-section bg-muted">
	<div class="site-container">
		<div class="max-w-2xl">
			<p class="eyebrow">The day</p>
			<h2 class="mt-4 uppercase">Six talks. One room. Seven hours.</h2>
			<p class="lead mt-5">
				40-minute talks with Q&A, a long lunch to meet people, and a fireside
				chat to close. Speakers are announced soon.
			</p>
		</div>

		<ol class="mt-12 flex flex-col gap-2 lg:flex-row lg:gap-1.5">
			{blocks.map((block) => (
				<li class="lg:min-w-0" style={`flex: ${block.minutes} 1 0%`}>
					<div
						class:list={[
							"h-3 rounded-full lg:h-16 lg:rounded-md",
							block.kind === "talk" && "bg-[image:var(--comday-gradient)]",
							block.kind === "session" && "bg-primary",
							block.kind === "break" && "border border-border bg-background",
						]}
					></div>
					<p class="mt-2 font-mono text-xs font-bold text-primary">{block.time}</p>
					<p class:list={["text-sm font-bold", block.kind === "break" ? "text-muted-foreground" : "text-white"]}>
						{block.label}
					</p>
				</li>
			))}
		</ol>
	</div>
</section>

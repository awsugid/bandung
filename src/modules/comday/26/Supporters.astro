---
const supporters = [
	{ name: "SBM ITB", file: "sbm-itb", size: "max-h-12 sm:max-h-14" },
	{ name: "Garuda Spark Innovation Hub", file: "garuda-spark", size: "max-h-24 sm:max-h-28" },
	{ name: "The Greater Hub", file: "the-greater-hub", size: "max-h-16 sm:max-h-20" },
];

const communityPartners = [
	{ name: "DevOps Indonesia", file: "devops-indonesia", size: "max-h-12 sm:max-h-14" },
	{ name: "DevOps Focus Group", file: "devops-focus-group", size: "max-h-9 sm:max-h-10" },
	{ name: "CloudKraf", file: "cloudkraf", size: "max-h-12 sm:max-h-14" },
	{ name: "IMPHNEN", file: "imphnen", size: "max-h-12 sm:max-h-14" },
	{ name: "bandung.py", file: "bandung-py", size: "max-h-12 sm:max-h-14" },
	{ name: "AI Connect", file: "ai-connect", size: "max-h-5 sm:max-h-6" },
];
---

<section class="site-section border-t border-border">
	<div class="site-container text-center">
		<p class="eyebrow">Supported by</p>
		<h2 class="mt-4 uppercase">Made possible by our partners.</h2>
		<p class="lead mx-auto mt-5 max-w-2xl">
			Community Day Bandung is a community event, and it only happens with the
			support of these organizations.
		</p>

		<ul class="mt-12 grid gap-4 sm:grid-cols-3">
			{supporters.map((supporter) => (
				<li
					class="flex h-32 items-center justify-center rounded-xl border border-border bg-white px-6 transition hover:border-primary/60 sm:h-36"
				>
					<img
						src={`/images/comday/supporters/${supporter.file}.webp`}
						alt={supporter.name}
						class:list={["w-auto max-w-full object-contain", supporter.size]}
						loading="lazy"
					/>
				</li>
			))}
		</ul>

		<p class="eyebrow mt-14">Community partners</p>
		<ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
			{communityPartners.map((partner) => (
				<li
					class="flex h-20 items-center justify-center rounded-xl border border-border bg-white px-4 transition hover:border-primary/60 sm:h-24"
				>
					<img
						src={`/images/comday/community-partners/${partner.file}.webp`}
						alt={partner.name}
						class:list={["w-auto max-w-full object-contain", partner.size]}
						loading="lazy"
					/>
				</li>
			))}
		</ul>
	</div>
</section>

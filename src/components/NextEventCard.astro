---
import type { CommunityEvent } from "@/lib/events";

interface Props {
	event: CommunityEvent;
	ctaLabel?: string;
	// Omit on the events page, where the details link would point to itself.
	detailsHref?: string;
}

const { event, ctaLabel = "Reserve a seat on Meetup", detailsHref } = Astro.props;
const toggleId = `description-${event.id}`;
// Only offer "Read more" when the text is likely to exceed the clamped lines.
const isLong = event.description.length > 240 || event.description.split("\n").length > 4;
---

<article class="aws-card overflow-hidden bg-background">
	{
		event.imageUrl && (
			<img src={event.imageUrl} alt={event.title} class="aspect-[16/9] w-full object-cover" />
		)
	}

	<div class="p-6 sm:p-8">
		<h3 class="text-2xl leading-tight sm:text-3xl">{event.title}</h3>
		<p class="mt-3 font-bold text-foreground">{event.dateLabel} · {event.timeLabel}</p>

		<div class="group mt-5">
			{isLong && <input type="checkbox" id={toggleId} class="peer sr-only" />}
			<p class:list={["whitespace-pre-line text-sm leading-6", isLong && "line-clamp-4 group-has-[:checked]:line-clamp-none"]}>
				{event.description}
			</p>
			{
				isLong && (
					<label
						for={toggleId}
						class="mt-2 inline-block cursor-pointer text-sm font-bold text-accent underline underline-offset-4 peer-focus-visible:outline-2 peer-focus-visible:outline-ring"
					>
						<span class="group-has-[:checked]:hidden">Read more</span>
						<span class="hidden group-has-[:checked]:inline">Show less</span>
					</label>
				)
			}
		</div>

		<div class="mt-8 flex flex-col gap-3 sm:flex-row">
			<a href={event.meetupUrl} target="_blank" rel="noopener noreferrer" class="button-primary">
				{ctaLabel}
			</a>
			{detailsHref && <a href={detailsHref} class="button-secondary">Event details</a>}
		</div>
	</div>
</article>

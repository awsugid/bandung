---
import { navItems } from "@/lib/navigation";
---

<header class="border-b border-border/70 bg-background/90 backdrop-blur">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
		<a href="/" class="flex items-center gap-3" aria-label="AWS User Group Bandung">
			<img src="/android-chrome-192x192.png" alt="" class="h-9 w-9" />
			<span class="text-sm font-bold uppercase tracking-[0.18em] text-foreground">
				AWS UG Bandung
			</span>
		</a>

		<nav class="hidden items-center gap-7 text-sm font-medium text-muted-foreground sm:flex">
			{
				navItems.map((item) => (
					<a href={item.href} class="transition-colors hover:text-foreground">
						{item.name}
					</a>
				))
			}
		</nav>
	</div>
</header>

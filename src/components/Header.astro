---
import { featuredEvent, hasUpcomingEvent } from "@/lib/events";
import { joinCommunityUrl, navItems } from "@/lib/navigation";

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => {
	const normalizedHref = href.replace(/\/$/, "") || "/";
	return normalizedHref === "/"
		? currentPath === "/"
		: currentPath.startsWith(normalizedHref);
};
---

<header class="sticky top-0 z-50 border-b border-border bg-background/95 backdrop-blur">
	{
		hasUpcomingEvent && (
			<a
				href="/events"
				class="block bg-aws-ink text-white transition hover:bg-aws-ink-soft"
				aria-label={`Next event: ${featuredEvent.title}, ${featuredEvent.dateLabel}. View events.`}
				data-countdown-start={featuredEvent.startDate}
				data-countdown-end={featuredEvent.endDate}
			>
				<span class="site-container flex items-center justify-center gap-3 py-2 text-xs sm:text-sm">
					<span class="shrink-0 font-bold uppercase tracking-[0.16em] text-primary">Next event</span>
					<span class="hidden min-w-0 truncate text-white/75 md:inline">{featuredEvent.title}</span>
					<span class="shrink-0 font-bold tabular-nums" data-countdown>
						{featuredEvent.dateLabel}
					</span>
					<span class="shrink-0" aria-hidden="true">-&gt;</span>
				</span>
			</a>
		)
	}
	<div class="h-1 bg-primary"></div>
	<div class="site-container flex min-h-[calc(var(--header-height)-0.25rem)] items-center justify-between gap-4 py-3">
		<a href="/" class="group flex min-w-0 items-center gap-3" aria-label="AWS User Group Bandung home">
			<img src="/images/awsug-bandung-logo.png" alt="" class="h-9 w-9 shrink-0" />
			<span class="min-w-0">
				<span class="block text-sm font-bold uppercase tracking-[0.18em] text-foreground">
					AWS UG Bandung
				</span>
				<span class="hidden text-xs font-medium text-muted-foreground sm:block">
					Learn AWS with local builders
				</span>
			</span>
		</a>

		<div class="flex items-center gap-2 sm:gap-5">
			<nav class="flex items-center gap-1 rounded-full border border-border bg-muted p-1" aria-label="Primary navigation">
				{
					navItems.map((item) => (
						<a
							href={item.href}
							aria-current={isActive(item.href) ? "page" : undefined}
							class:list={[
								"rounded-full px-3 py-2 text-sm font-bold transition sm:px-4",
								isActive(item.href)
									? "bg-background text-foreground shadow-sm"
									: "text-muted-foreground hover:text-foreground",
							]}
						>
							{item.name}
						</a>
					))
				}
			</nav>

			<a
				href={joinCommunityUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="hidden h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-bold text-primary-foreground transition hover:bg-primary/90 md:inline-flex"
			>
				Join the Meetup
			</a>
		</div>
	</div>
</header>

<script>
	// Ticks the next event countdown; the server-rendered date stays if JS is off.
	const bar = document.querySelector<HTMLElement>("[data-countdown-start]");
	const label = bar?.querySelector<HTMLElement>("[data-countdown]");

	if (bar && label) {
		const start = Date.parse(bar.dataset.countdownStart ?? "");
		const end = Date.parse(bar.dataset.countdownEnd ?? "");
		const pad = (value: number) => String(value).padStart(2, "0");

		const tick = () => {
			const now = Date.now();
			if (now >= end) {
				bar.hidden = true;
				clearInterval(timer);
				return;
			}
			if (now >= start) {
				label.textContent = "Happening now";
				return;
			}
			const seconds = Math.floor((start - now) / 1000);
			const days = Math.floor(seconds / 86_400);
			const hours = Math.floor((seconds % 86_400) / 3_600);
			const minutes = Math.floor((seconds % 3_600) / 60);
			label.textContent = `Starts in ${days > 0 ? `${days}d ` : ""}${pad(hours)}h ${pad(minutes)}m ${pad(seconds % 60)}s`;
		};

		const timer = setInterval(tick, 1_000);
		tick();
	}
</script>

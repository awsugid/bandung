---
interface Props {
	title: string;
	description: string;
	dateLabel?: string;
	href?: string;
	ctaLabel?: string;
	imageUrl?: string;
}

const {
	title,
	description,
	dateLabel = "Date to be announced",
	href,
	ctaLabel = "View details",
	imageUrl,
} = Astro.props;

const Tag = href ? "a" : "article";
---

<Tag
	href={href}
	class:list={[
		"aws-card group flex h-full flex-col overflow-hidden bg-background transition",
		href && "aws-card-hover",
	]}
>
	{
		imageUrl && (
			<figure class="overflow-hidden bg-aws-ink">
				<img
					src={imageUrl}
					alt={title}
					class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
				/>
			</figure>
		)
	}
	<div class="flex flex-1 flex-col p-6">
		<h3 class="line-clamp-3 min-h-[3lh] text-2xl leading-tight">{title}</h3>
		<p class="mt-2 text-sm font-bold text-foreground">{dateLabel}</p>
		<p class="mt-3 line-clamp-3 text-sm">{description}</p>

		{
			href && (
				<div class="mt-auto flex items-center pt-8 text-sm font-bold text-foreground">
					<span>{ctaLabel}</span>
					<span class="ml-2 transition group-hover:translate-x-1" aria-hidden="true">
						-&gt;
					</span>
				</div>
			)
		}
	</div>
</Tag>

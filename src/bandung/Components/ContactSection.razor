@using bandung.Models

<section class="contact-section py-5" id="contact">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center mb-5">
                <h2 class="section-title">Get In Touch</h2>
                <p class="section-subtitle">Connect with us and join our growing community</p>
            </div>
        </div>
        
        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="contact-info">
                    <h3 class="mb-4">Contact Information</h3>
                    
                    @if (!string.IsNullOrEmpty(ContactInfo.PrimaryEmail))
                    {
                        <div class="contact-item">
                            <div class="contact-icon">
                                <i class="bi bi-envelope"></i>
                            </div>
                            <div class="contact-details">
                                <h5>Email Us</h5>
                                <a href="mailto:@ContactInfo.PrimaryEmail" class="contact-link">
                                    @ContactInfo.PrimaryEmail
                                </a>
                            </div>
                        </div>
                    }
                    
                    @if (ContactInfo.SocialMediaLinks.Any())
                    {
                        <div class="contact-item">
                            <div class="contact-icon">
                                <i class="bi bi-share"></i>
                            </div>
                            <div class="contact-details">
                                <h5>Follow Us</h5>
                                <div class="social-links">
                                    @foreach (var social in ContactInfo.SocialMediaLinks)
                                    {
                                        <a href="@social.Value" class="social-link" target="_blank" rel="noopener" title="@social.Key">
                                            @GetSocialIcon(social.Key)
                                            <span class="social-name">@social.Key</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            
            <div class="col-lg-6 mb-4">
                @if (ContactInfo.OnlinePlatforms.Any())
                {
                    <div class="community-platforms">
                        <h3 class="mb-4">Join Our Community</h3>
                        
                        @foreach (var platform in ContactInfo.OnlinePlatforms)
                        {
                            <div class="platform-card">
                                <div class="platform-info">
                                    <h5 class="platform-name">@platform.Name</h5>
                                    <p class="platform-purpose">@platform.Purpose</p>
                                </div>
                                <div class="platform-action">
                                    <a href="@platform.Url" class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener">
                                        Join Now
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="contact-cta">
                        <h3 class="mb-3">Ready to Join?</h3>
                        <p class="mb-4">Connect with AWS enthusiasts and professionals in Bandung. Let's learn and grow together!</p>
                        @if (!string.IsNullOrEmpty(ContactInfo.PrimaryEmail))
                        {
                            <a href="mailto:@ContactInfo.PrimaryEmail" class="btn btn-aws-primary">
                                Contact Us
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter] public ContactInfo ContactInfo { get; set; } = new();
    
    protected override void OnParametersSet()
    {
        // Ensure ContactInfo is never null
        ContactInfo ??= new ContactInfo
        {
            PrimaryEmail = string.Empty,
            SocialMediaLinks = new Dictionary<string, string>(),
            OnlinePlatforms = new List<CommunityPlatform>()
        };
        
        // Ensure collections are never null
        ContactInfo.SocialMediaLinks ??= new Dictionary<string, string>();
        ContactInfo.OnlinePlatforms ??= new List<CommunityPlatform>();
        
        // Filter out invalid social media links (malformed URLs)
        var validSocialLinks = new Dictionary<string, string>();
        foreach (var link in ContactInfo.SocialMediaLinks)
        {
            if (!string.IsNullOrWhiteSpace(link.Key) && 
                !string.IsNullOrWhiteSpace(link.Value) && 
                IsValidUrl(link.Value))
            {
                validSocialLinks[link.Key] = link.Value;
            }
        }
        ContactInfo.SocialMediaLinks = validSocialLinks;
        
        // Filter out invalid platforms
        ContactInfo.OnlinePlatforms = ContactInfo.OnlinePlatforms
            .Where(p => p != null && 
                       !string.IsNullOrWhiteSpace(p.Name) && 
                       !string.IsNullOrWhiteSpace(p.Url) &&
                       IsValidUrl(p.Url))
            .ToList();
    }
    
    private bool IsValidUrl(string url)
    {
        return Uri.TryCreate(url, UriKind.Absolute, out var uriResult) &&
               (uriResult.Scheme == Uri.UriSchemeHttp || uriResult.Scheme == Uri.UriSchemeHttps);
    }
    
    private string GetSocialIcon(string platform)
    {
        return platform.ToLower() switch
        {
            "linkedin" => "🔗",
            "twitter" => "🐦",
            "telegram" => "📱",
            "discord" => "💬",
            "slack" => "💼",
            "github" => "🐙",
            "youtube" => "📺",
            "facebook" => "📘",
            "instagram" => "📷",
            _ => "🌐"
        };
    }
}
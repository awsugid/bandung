@using bandung.Models

<section class="about-section py-5" id="about">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="text-center mb-5">
                    <h2 class="section-title">About @CommunityInfo.Name</h2>
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="col-lg-6 mb-4">
                <div class="about-content">
                    <h3 class="mb-3">Our Mission</h3>
                    <p class="lead">@CommunityInfo.Mission</p>
                    
                    @if (CommunityInfo.Activities.Any())
                    {
                        <h4 class="mt-4 mb-3">What We Do</h4>
                        <ul class="activities-list">
                            @foreach (var activity in CommunityInfo.Activities)
                            {
                                <li>@activity</li>
                            }
                        </ul>
                    }
                </div>
            </div>
            
            <div class="col-lg-6 mb-4">
                <div class="benefits-content">
                    @if (CommunityInfo.Benefits.Any())
                    {
                        <h3 class="mb-3">Why Join Us?</h3>
                        <ul class="benefits-list">
                            @foreach (var benefit in CommunityInfo.Benefits)
                            {
                                <li>@benefit</li>
                            }
                        </ul>
                    }
                    
                    @if (ShowStats && CommunityInfo.Stats != null)
                    {
                        <div class="stats-section mt-4">
                            <h4 class="mb-3">Community Stats</h4>
                            <div class="row text-center">
                                <div class="col-4">
                                    <div class="stat-item">
                                        <div class="stat-number">@CommunityInfo.Stats.MemberCount</div>
                                        <div class="stat-label">Members</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="stat-item">
                                        <div class="stat-number">@CommunityInfo.Stats.EventsHeld</div>
                                        <div class="stat-label">Events</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="stat-item">
                                        <div class="stat-number">@CommunityInfo.Stats.EstablishedDate.Year</div>
                                        <div class="stat-label">Since</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter] public CommunityInfo CommunityInfo { get; set; } = new();
    [Parameter] public bool ShowStats { get; set; } = true;
    
    protected override void OnParametersSet()
    {
        // Ensure CommunityInfo is never null
        CommunityInfo ??= new CommunityInfo
        {
            Name = "AWS User Group Bandung",
            Mission = "Join our community of AWS enthusiasts and professionals.",
            Activities = new List<string>(),
            Benefits = new List<string>(),
            Stats = null!
        };
        
        // Ensure collections are never null
        CommunityInfo.Activities ??= new List<string>();
        CommunityInfo.Benefits ??= new List<string>();
    }
}
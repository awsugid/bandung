@using bandung.Models

<section class="events-section py-5" id="events">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center mb-5">
                <h2 class="section-title">Upcoming Events</h2>
                <p class="section-subtitle">Join us for exciting AWS learning opportunities and networking</p>
            </div>
        </div>
        
        <div class="row">
            @if (ValidEvents.Any())
            {
                @foreach (var eventItem in ValidEvents.Take(MaxEventsToShow))
                {
                    <div class="col-lg-6 col-md-6 mb-4">
                        <div class="event-card">
                            <div class="event-date">
                                <div class="event-day">@eventItem.Date.Day</div>
                                <div class="event-month">@eventItem.Date.ToString("MMM")</div>
                            </div>
                            <div class="event-content">
                                <h4 class="event-title">@eventItem.Title</h4>
                                <div class="event-meta">
                                    <div class="event-time">
                                        <i class="bi bi-clock"></i>
                                        @eventItem.Date.ToString("HH:mm")
                                    </div>
                                    @if (!string.IsNullOrEmpty(eventItem.Location))
                                    {
                                        <div class="event-location">
                                            <i class="bi bi-geo-alt"></i>
                                            @eventItem.Location
                                        </div>
                                    }
                                </div>
                                <p class="event-description">@eventItem.Description</p>
                                
                                @if (eventItem.Topics != null && eventItem.Topics.Any())
                                {
                                    <div class="event-topics">
                                        @foreach (var topic in eventItem.Topics)
                                        {
                                            <span class="topic-tag">@topic</span>
                                        }
                                    </div>
                                }
                                
                                @if (!string.IsNullOrEmpty(eventItem.RegistrationUrl))
                                {
                                    <div class="event-actions mt-3">
                                        <a href="@eventItem.RegistrationUrl" class="btn btn-aws-primary" target="_blank" rel="noopener">
                                            Register Now
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <div class="no-events-message">
                        <h4>No Upcoming Events</h4>
                        <p class="text-muted">Stay tuned for exciting AWS events and meetups!</p>
                        @if (!string.IsNullOrEmpty(NotificationSignupUrl))
                        {
                            <a href="@NotificationSignupUrl" class="btn btn-outline-primary">
                                Get Notified
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
        
        @if (ValidEvents.Count > MaxEventsToShow)
        {
            <div class="row">
                <div class="col-12 text-center mt-4">
                    <button class="btn btn-outline-secondary" @onclick="ShowMoreEvents">
                        Show More Events (@(ValidEvents.Count - MaxEventsToShow) more)
                    </button>
                </div>
            </div>
        }
    </div>
</section>

@code {
    [Parameter] public List<Event> Events { get; set; } = new();
    [Parameter] public string NotificationSignupUrl { get; set; } = string.Empty;
    [Parameter] public int InitialEventsToShow { get; set; } = 4;
    
    private int MaxEventsToShow { get; set; }
    private List<Event> ValidEvents { get; set; } = new();
    
    protected override void OnInitialized()
    {
        MaxEventsToShow = InitialEventsToShow;
    }
    
    protected override void OnParametersSet()
    {
        // Ensure Events is never null
        Events ??= new List<Event>();
        
        // Filter out invalid events (missing title or date)
        ValidEvents = Events
            .Where(e => e != null && !string.IsNullOrWhiteSpace(e.Title) && e.Date != default)
            .OrderBy(e => e.Date)
            .ToList();
    }
    
    private void ShowMoreEvents()
    {
        MaxEventsToShow = ValidEvents.Count;
    }
}
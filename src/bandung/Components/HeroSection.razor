@using bandung.Models

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-8 col-md-10 mx-auto text-center">
                <h1 class="hero-title display-4 fw-bold mb-4">@Title</h1>
                <p class="hero-subtitle lead mb-5">@Subtitle</p>
                @if (!string.IsNullOrEmpty(PrimaryActionUrl) && !string.IsNullOrEmpty(PrimaryActionText))
                {
                    <a href="@PrimaryActionUrl" class="btn btn-aws-primary btn-lg px-5 py-3">
                        @PrimaryActionText
                    </a>
                }
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter] public string Title { get; set; } = "AWS User Group Bandung";
    [Parameter] public string Subtitle { get; set; } = "Join our community of AWS enthusiasts, developers, and professionals in Bandung";
    [Parameter] public string PrimaryActionText { get; set; } = "Join Our Community";
    [Parameter] public string PrimaryActionUrl { get; set; } = "#contact";
}
---
import EventCard from "@/components/EventCard.astro";
import Layout from "../layouts/Layout.astro";
import { joinCommunityUrl } from "@/lib/navigation";
---

<Layout
	title="AWS User Group Bandung"
	description="Join AWS User Group Bandung to learn AWS Cloud, meet local builders, and grow with the Bandung tech community."
>
	<section class="relative overflow-hidden border-b border-border bg-background">
		<div class="absolute inset-x-0 top-0 h-28 bg-[linear-gradient(180deg,var(--aws-frost),transparent)]"></div>
		<div class="site-container relative grid min-h-[calc(100vh-var(--header-height))] items-center gap-12 py-16 lg:grid-cols-[1.08fr_0.92fr] lg:py-20">
			<div class="max-w-3xl">
				<p class="eyebrow">AWS User Group Bandung</p>
				<h1 class="mt-5 max-w-4xl">
					Learn AWS Cloud with builders in Bandung.
				</h1>
				<p class="lead mt-6 max-w-2xl">
					Join community-led meetups for technical talks, hands-on learning,
					and practical conversations with local developers, architects,
					students, and cloud practitioners.
				</p>

				<div class="mt-9 flex flex-col gap-3 sm:flex-row">
					<a
						href={joinCommunityUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="button-primary"
					>
						Join the Meetup
					</a>
					<a href="/events" class="button-secondary">
						View events
					</a>
				</div>
			</div>

			<aside class="aws-card overflow-hidden" aria-label="Community snapshot">
				<div class="h-2 bg-primary"></div>
				<div class="p-6 sm:p-8">
					<div class="flex items-start justify-between gap-6">
						<div>
							<p class="text-sm font-bold uppercase tracking-[0.18em] text-muted-foreground">
								Community snapshot
							</p>
							<h2 class="mt-4 text-3xl leading-tight">
								AWS User Group Bandung
							</h2>
						</div>
						<img src="/android-chrome-192x192.png" alt="" class="h-12 w-12 shrink-0" />
					</div>

					<div class="mt-8 divide-y divide-border border-y border-border">
						<div class="grid grid-cols-[1rem_1fr] gap-4 py-4">
							<span class="mt-2 h-2 w-2 rounded-full bg-primary"></span>
							<div>
								<h3 class="text-base">Community-led</h3>
								<p class="mt-1 text-sm">
									Organized around local builders, shared questions, and practical
									AWS learning.
								</p>
							</div>
						</div>
						<div class="grid grid-cols-[1rem_1fr] gap-4 py-4">
							<span class="mt-2 h-2 w-2 rounded-full bg-aws-ink"></span>
							<div>
								<h3 class="text-base">Peer learning</h3>
								<p class="mt-1 text-sm">
									Talks, demos, workshops, and conversations with people using AWS
									in real projects.
								</p>
							</div>
						</div>
						<div class="grid grid-cols-[1rem_1fr] gap-4 py-4">
							<span class="mt-2 h-2 w-2 rounded-full bg-aws-blue"></span>
							<div>
								<h3 class="text-base">Open to all levels</h3>
								<p class="mt-1 text-sm">
									For students, developers, architects, operators, and anyone
									learning the cloud.
								</p>
							</div>
						</div>
					</div>

					<p class="mt-6 text-sm font-medium text-foreground">
						Meetups may be in-person or virtual depending on the session.
					</p>
				</div>
			</aside>
		</div>
	</section>

	<section class="site-section bg-muted">
		<div class="site-container">
			<div class="section-grid">
				<div>
					<p class="eyebrow">About the community</p>
					<h2 class="mt-4">
						A local place to learn, ask, and share AWS knowledge.
					</h2>
				</div>

				<div class="grid gap-8">
					<p class="lead">
						AWS User Group Bandung is a community-led group for people who
						build, operate, study, or explore cloud technology with AWS.
						The goal is simple: make it easier for local builders to learn
						from one another.
					</p>

					<div class="grid gap-4 sm:grid-cols-3">
						<div class="aws-card bg-background p-5">
							<h3 class="text-lg">Learn from peers</h3>
							<p class="mt-2 text-sm">
								Technical talks, demos, and discussions shaped by real questions
								from the community.
							</p>
						</div>
						<div class="aws-card bg-background p-5">
							<h3 class="text-lg">Meet local builders</h3>
							<p class="mt-2 text-sm">
								Connect with developers, architects, students, operators, and
								teams around Bandung.
							</p>
						</div>
						<div class="aws-card bg-background p-5">
							<h3 class="text-lg">Grow together</h3>
							<p class="mt-2 text-sm">
								Share what works, what failed, and what you are learning while
								building on AWS.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="site-section bg-background">
		<div class="site-container">
			<div class="section-grid">
				<div>
					<p class="eyebrow">What to expect</p>
					<h2 class="mt-4">
						Meetups built around practical AWS learning.
					</h2>
				</div>

				<div>
					<p class="lead">
						Join sessions shaped around real cloud work: service deep dives,
						architecture discussions, hands-on practice, short member talks,
						and lessons from builders working through similar problems.
					</p>

					<div class="mt-10 grid gap-4 sm:grid-cols-2">
						<div class="aws-card aws-card-hover p-6">
							<p class="text-sm font-bold text-primary">01</p>
							<h3 class="mt-5">Technical talks</h3>
							<p class="mt-3 text-sm">
								Sessions on AWS services, architecture patterns, security,
								reliability, and production lessons.
							</p>
						</div>
						<div class="aws-card aws-card-hover p-6">
							<p class="text-sm font-bold text-primary">02</p>
							<h3 class="mt-5">Hands-on workshops</h3>
							<p class="mt-3 text-sm">
								Guided practice for builders who want to try services, tools,
								and cloud patterns directly.
							</p>
						</div>
						<div class="aws-card aws-card-hover p-6">
							<p class="text-sm font-bold text-primary">03</p>
							<h3 class="mt-5">Community discussions</h3>
							<p class="mt-3 text-sm">
								Open space for questions, architecture reviews, demos, career
								conversations, and peer feedback.
							</p>
						</div>
						<div class="aws-card aws-card-hover p-6">
							<p class="text-sm font-bold text-primary">04</p>
							<h3 class="mt-5">Lightning talks</h3>
							<p class="mt-3 text-sm">
								Short shares from members about what they built, learned,
								fixed, explored, or want to discuss next.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="site-section bg-muted">
		<div class="site-container">
			<div class="section-grid">
				<div>
					<p class="eyebrow">Events preview</p>
					<h2 class="mt-4">
						The next Bandung meetup is being planned.
					</h2>
				</div>

				<div>
					<p class="lead">
						We will publish upcoming sessions here once dates and venues are
						confirmed. Join the Meetup group to get notified when registration
						opens.
					</p>

					<div class="mt-10 grid gap-4 lg:grid-cols-[1fr_0.72fr]">
						<EventCard
							title="AWS User Group Bandung meetup"
							description="A community session for AWS builders in Bandung. Topic, date, and venue will be announced after the organizing details are confirmed."
							dateLabel="To be announced"
							location="Bandung or online"
							type="Community meetup"
							statusLabel="Planning"
							href="/events"
							ctaLabel="Open events page"
						/>

						<div class="aws-card bg-background p-6">
							<h3>Get notified first</h3>
							<p class="mt-3 text-sm">
								Meetup is the main channel for event announcements, reminders,
								and registration updates.
							</p>
							<a
								href={joinCommunityUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="button-primary mt-8 w-full"
							>
								Join the Meetup
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="site-section bg-background">
		<div class="site-container">
			<div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
				<div>
					<p class="eyebrow">Ways to participate</p>
					<h2 class="mt-4">
						Join as an attendee, speaker, host, or organizer.
					</h2>
					<p class="lead mt-6">
						Start small. Come to a session, ask a question, share what you are
						learning, or help create the next community meetup.
					</p>
				</div>

				<div class="aws-card overflow-hidden bg-background">
					<div class="grid divide-y divide-border">
						<div class="grid gap-4 p-6 sm:grid-cols-[5rem_1fr] sm:p-7">
							<p class="text-3xl font-bold text-primary">01</p>
							<div>
								<h3>Attend a meetup</h3>
								<p class="mt-2 text-sm">
									Meet local AWS builders, follow technical sessions, and bring
									questions from your own learning or work.
								</p>
							</div>
						</div>
						<div class="grid gap-4 p-6 sm:grid-cols-[5rem_1fr] sm:p-7">
							<p class="text-3xl font-bold text-primary">02</p>
							<div>
								<h3>Share a talk</h3>
								<p class="mt-2 text-sm">
									Present a short demo, architecture story, migration lesson,
									or practical tip other builders can use.
								</p>
							</div>
						</div>
						<div class="grid gap-4 p-6 sm:grid-cols-[5rem_1fr] sm:p-7">
							<p class="text-3xl font-bold text-primary">03</p>
							<div>
								<h3>Host a session</h3>
								<p class="mt-2 text-sm">
									Offer a venue, classroom, office space, or workshop setting for
									a future community gathering.
								</p>
							</div>
						</div>
						<div class="grid gap-4 p-6 sm:grid-cols-[5rem_1fr] sm:p-7">
							<p class="text-3xl font-bold text-primary">04</p>
							<div>
								<h3>Help organize</h3>
								<p class="mt-2 text-sm">
									Support planning, speaker coordination, event operations,
									documentation, or community communication.
								</p>
							</div>
						</div>
					</div>

					<div class="border-t border-border bg-muted p-6 sm:flex sm:items-center sm:justify-between sm:gap-6 sm:p-7">
						<p class="text-sm font-medium text-foreground">
							The easiest first step is joining the Meetup group.
						</p>
						<a
							href={joinCommunityUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="button-secondary mt-5 shrink-0 bg-background sm:mt-0"
						>
							Join the Meetup
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="bg-muted py-16 sm:py-20">
		<div class="site-container">
			<div class="relative overflow-hidden rounded-lg border border-border bg-aws-ink p-8 text-white sm:p-10 lg:p-12">
				<div class="absolute inset-x-0 top-0 h-2 bg-primary"></div>
				<div class="relative grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
					<div class="max-w-2xl">
						<p class="text-sm font-bold uppercase tracking-[0.18em] text-primary">
							Join the community
						</p>
						<h2 class="mt-4 text-3xl leading-tight text-white sm:text-4xl">
							Get notified when the next AWS meetup in Bandung is announced.
						</h2>
						<p class="mt-5 text-base leading-7 text-white/70">
							Join the Meetup group to follow upcoming sessions, registration
							updates, and ways to take part.
						</p>
					</div>

					<a
						href={joinCommunityUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex h-12 items-center justify-center rounded-md bg-primary px-6 text-sm font-bold text-primary-foreground transition hover:bg-primary/90"
					>
						Join the Meetup
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

---
import Layout from "@/layouts/Layout.astro";
import { featuredEvent, getEventJsonLd } from "@/lib/events";
import { absoluteUrl, site } from "@/lib/site";
import About from "@/modules/home/About.astro";
import EventsPreview from "@/modules/home/EventsPreview.astro";
import Faq from "@/modules/home/Faq.astro";
import Hero from "@/modules/home/Hero.astro";
import JoinCta from "@/modules/home/JoinCta.astro";
import Momentum from "@/modules/home/Momentum.astro";
import Participate from "@/modules/home/Participate.astro";
import WhatToExpect from "@/modules/home/WhatToExpect.astro";
import { faqs } from "@/modules/home/faqs";

const homeStructuredData = [
	{
		"@context": "https://schema.org",
		"@type": "WebPage",
		name: site.name,
		url: absoluteUrl("/"),
		description: site.description,
		inLanguage: site.language,
		about: ["AWS Cloud", "Cloud computing", "Developer community", "Bandung"],
	},
	{
		"@context": "https://schema.org",
		"@type": "FAQPage",
		mainEntity: faqs.map((faq) => ({
			"@type": "Question",
			name: faq.question,
			acceptedAnswer: {
				"@type": "Answer",
				text: faq.answer,
			},
		})),
	},
	getEventJsonLd(featuredEvent),
];
---

<Layout
	title="AWS User Group Bandung"
	description="Join AWS User Group Bandung to learn AWS Cloud, meet local builders, and grow with the Bandung tech community."
	canonicalPath="/"
	structuredData={homeStructuredData}
>
	<Hero />
	<Momentum />
	<About />
	<WhatToExpect />
	<EventsPreview />
	<Participate />
	<Faq />
	<JoinCta />
</Layout>

---
import EventCard from "@/components/EventCard.astro";
import Layout from "@/layouts/Layout.astro";
import { featuredEvent, meetupGroupUrl, pastEvents } from "@/lib/events";
---

<Layout
	title="Events | AWS User Group Bandung"
	description="Upcoming, current, and past AWS User Group Bandung meetups, speakers, topics, and venue details."
>
	<section class="site-section bg-background">
		<div class="site-container">
			<div class="max-w-3xl">
				<p class="eyebrow">Events</p>
				<h1 class="mt-5">
					The AWS Bandung meetup board.
				</h1>
				<p class="lead mt-6">
					Find the next AWS User Group Bandung session and browse previous
					meetups from the community archive.
				</p>
			</div>
		</div>
	</section>

	<section class="border-y border-border bg-muted py-10 sm:py-12">
		<div class="site-container">
			<div class="overflow-hidden rounded-lg border border-border bg-background shadow-[0_22px_56px_hsl(213_28%_11%_/_0.1)]">
				<figure class="border-b border-border bg-aws-ink">
					<img
						src={featuredEvent.imageUrl}
						alt={featuredEvent.title}
						class="aspect-[16/9] w-full object-contain"
					/>
				</figure>

				<div class="p-6 sm:p-8 lg:p-10">
					<div class="flex flex-wrap items-center gap-2">
						<span class="rounded-full bg-primary/15 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-foreground">
							{featuredEvent.type}
						</span>
						<span class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground">
							{featuredEvent.statusLabel}
						</span>
						<span class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground">
							{featuredEvent.priceLabel}
						</span>
					</div>

					<p class="eyebrow mt-8">Next up</p>
					<h2 class="mt-4">
						{featuredEvent.title}
					</h2>
					<p class="lead mt-5">
						{featuredEvent.description}
					</p>

					<div class="mt-8 grid gap-4 border-y border-border py-6 text-sm sm:grid-cols-3">
						<div>
							<p class="font-bold text-foreground">Date and time</p>
							<p class="mt-1">
								{featuredEvent.dateLabel}
								<br />
								{featuredEvent.timeLabel}
							</p>
						</div>
						<div>
							<p class="font-bold text-foreground">Venue</p>
							<p class="mt-1">
								{featuredEvent.location}
							</p>
						</div>
						<div>
							<p class="font-bold text-foreground">Host</p>
							<p class="mt-1">
								{featuredEvent.hostDisplayName}
							</p>
						</div>
						<div class="sm:col-span-3">
							<p class="font-bold text-foreground">Address</p>
							<p class="mt-1">
								{featuredEvent.address} · {featuredEvent.city}
							</p>
						</div>
					</div>

					<div class="mt-8 flex flex-col gap-3 sm:flex-row">
						<a
							href={featuredEvent.meetupUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="button-primary"
						>
							Attend on Meetup
						</a>
						<a
							href={featuredEvent.mapUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="button-secondary"
						>
							Open map
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="site-section bg-background">
		<div class="site-container">
			<div class="max-w-3xl">
				<p class="eyebrow">Past events</p>
				<h2 class="mt-4">
					What the community has covered.
				</h2>
				<p class="lead mt-5">
					Past sessions make the archive useful for new members: they show the
					topics, speakers, and venues that shaped the group so far.
				</p>
			</div>

			<div class="mt-10 grid gap-5 md:grid-cols-2">
				{
					pastEvents.map((event) => (
						<EventCard
							title={event.title}
							description={event.description}
							dateLabel={`${event.dateLabel}, ${event.timeLabel}`}
							location={`${event.location}, ${event.city}`}
							type={event.type}
							statusLabel={event.statusLabel}
							href={event.meetupUrl}
							ctaLabel="View on Meetup"
							imageUrl={event.imageUrl}
						/>
					))
				}
			</div>
		</div>
	</section>

	<section class="site-section bg-muted">
		<div class="site-container">
			<div class="sm:flex sm:items-center sm:justify-between sm:gap-6">
				<div>
					<h3>Follow the Meetup group</h3>
					<p class="mt-2 text-sm">
						Meetup stays the source of truth for RSVP status, attendee changes,
						venue updates, and future AWS User Group Bandung events.
					</p>
				</div>
				<a
					href={meetupGroupUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="button-primary mt-5 shrink-0 sm:mt-0"
				>
					Open Meetup group
				</a>
			</div>
		</div>
	</section>
</Layout>

---
import EventCard from "@/components/EventCard.astro";
import Layout from "@/layouts/Layout.astro";
import { events, featuredEvent, meetupGroupUrl } from "@/lib/events";
---

<Layout
	title="Events | AWS User Group Bandung"
	description="Upcoming AWS User Group Bandung events, meetups, speakers, topics, and venue details."
>
	<section class="site-section bg-background">
		<div class="site-container">
			<div class="max-w-3xl">
				<p class="eyebrow">Events</p>
				<h1 class="mt-5">
					Meetups for AWS builders in Bandung.
				</h1>
				<p class="lead mt-6">
					Find upcoming AWS User Group Bandung sessions, speaker topics,
					venues, and registration links.
				</p>
			</div>
		</div>
	</section>

	<section class="border-y border-border bg-muted py-10 sm:py-12">
		<div class="site-container">
			<div class="overflow-hidden rounded-lg border border-border bg-background">
				<figure class="overflow-hidden bg-aws-ink">
					<img
						src={featuredEvent.imageUrl}
						alt={featuredEvent.title}
						class="aspect-[16/9] w-full object-cover"
					/>
				</figure>

				<div class="p-6 sm:p-8 lg:p-10">
					<div class="flex flex-wrap items-center gap-2">
						<span class="rounded-full bg-primary/15 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-foreground">
							{featuredEvent.type}
						</span>
						<span class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground">
							{featuredEvent.statusLabel}
						</span>
						<span class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground">
							{featuredEvent.priceLabel}
						</span>
					</div>

					<h2 class="mt-6">
						{featuredEvent.title}
					</h2>
					<p class="lead mt-5">
						{featuredEvent.description}
					</p>

					<div class="mt-8 grid gap-4 border-y border-border py-6 text-sm sm:grid-cols-3">
						<div>
							<p class="font-bold text-foreground">Date and time</p>
							<p class="mt-1">
								{featuredEvent.dateLabel}
								<br />
								{featuredEvent.timeLabel}
							</p>
						</div>
						<div>
							<p class="font-bold text-foreground">Venue</p>
							<p class="mt-1">
								{featuredEvent.location}
							</p>
						</div>
						<div>
							<p class="font-bold text-foreground">Host</p>
							<p class="mt-1">
								{featuredEvent.hostDisplayName}
							</p>
						</div>
						<div class="sm:col-span-3">
							<p class="font-bold text-foreground">Address</p>
							<p class="mt-1">
								{featuredEvent.address} · {featuredEvent.city}
							</p>
						</div>
					</div>

					<div class="mt-8 flex flex-col gap-3 sm:flex-row">
						<a
							href={featuredEvent.meetupUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="button-primary"
						>
							Attend on Meetup
						</a>
						<a
							href={featuredEvent.mapUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="button-secondary"
						>
							Open map
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="site-section bg-background">
		<div class="site-container">
			<div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr]">
				<div>
					<p class="eyebrow">Session details</p>
					<h2 class="mt-4">
						What this meetup covers.
					</h2>
				</div>

				<div class="grid gap-6">
					<div class="aws-card bg-background p-6 sm:p-8">
						<h3>Speaker</h3>
						<div class="mt-6 grid gap-6">
							{
								featuredEvent.speakers.map((speaker) => (
									<div class="border-t border-border pt-6 first:border-t-0 first:pt-0">
										<p class="text-lg font-bold text-foreground">{speaker.name}</p>
										<p class="mt-1 text-sm">{speaker.role}</p>
										<p class="mt-4 text-sm font-bold text-foreground">Topic</p>
										<p class="mt-1 text-sm">{speaker.topic}</p>
									</div>
								))
							}
						</div>
					</div>

					<div class="aws-card bg-muted p-6 sm:p-8">
						<h3>Event notes</h3>
						<div class="mt-5 grid gap-4">
							{
								featuredEvent.details.map((detail) => (
									<p class="text-sm">{detail}</p>
								))
							}
						</div>
					</div>

					<div class="grid gap-4 sm:grid-cols-3">
						<div class="aws-card bg-background p-5">
							<p class="text-sm font-bold text-primary">Group rating</p>
							<p class="mt-4 text-3xl font-bold text-foreground">
								{featuredEvent.groupRating}
							</p>
							<p class="mt-2 text-sm">
								{featuredEvent.groupReviewCount} reviews on Meetup.
							</p>
						</div>
						<div class="aws-card bg-background p-5">
							<p class="text-sm font-bold text-primary">Attendees</p>
							<p class="mt-4 text-3xl font-bold text-foreground">
								{featuredEvent.attendeeCount}
							</p>
							<p class="mt-2 text-sm">
								Current attendee count shown on Meetup.
							</p>
						</div>
						<div class="aws-card bg-background p-5">
							<p class="text-sm font-bold text-primary">Related topics</p>
							<div class="mt-4 flex flex-wrap gap-2">
								{
									featuredEvent.topics.map((topic) => (
										<span class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-bold text-foreground">
											{topic}
										</span>
									))
								}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="site-section bg-muted">
		<div class="site-container">
			<div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr]">
				<div>
					<p class="eyebrow">All events</p>
					<h2 class="mt-4">
						Upcoming sessions.
					</h2>
				</div>

				<div class="grid gap-4">
					{
						events.map((event) => (
							<EventCard
								title={event.title}
								description={event.description}
								dateLabel={`${event.dateLabel}, ${event.timeLabel}`}
								location={`${event.location}, ${event.city}`}
								type={event.type}
								statusLabel={event.statusLabel}
								href={event.meetupUrl}
								ctaLabel="Attend on Meetup"
							/>
						))
					}
				</div>
			</div>

			<div class="mt-10 border border-border bg-background p-6 sm:flex sm:items-center sm:justify-between sm:gap-6">
				<div>
					<h3>Follow the Meetup group</h3>
					<p class="mt-2 text-sm">
						Meetup is the source of truth for RSVP status, attendee count,
						venue updates, and future AWS User Group Bandung events.
					</p>
				</div>
				<a
					href={meetupGroupUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="button-primary mt-5 shrink-0 sm:mt-0"
				>
					Open Meetup group
				</a>
			</div>
		</div>
	</section>
</Layout>
